@page "/twitch/accounts"
@using Jolt2._0.Components.Span
@using Nixill.Streaming.JoltBot.BotData
@using Nixill.Streaming.JoltBot.Twitch
@using Nixill.Utils.Extensions

<PageTitle>Twitch Account Manager</PageTitle>

<MudText>
  This page lists the Twitch accounts to which the bot is connected. You may connect a new account or update a
  connection using the link at the bottom of the page.
</MudText>

@{
  var accounts = Data.Twitch.Accounts;
  if (accounts.Any())
  {
    <MudRadioGroup T="JoltTwitchAccountPair" @bind-Value="Active"
        @bind-Value:after="() => JoltTwitchAccountManager.SetActiveAccounts(Active.Streamer.UID)">
      <MudTable T="JoltTwitchAccountPair" Items="Data.Twitch.Accounts.Values">
        <HeaderContent>
          <MudTh>Active</MudTh>
          <MudTh>Streamer account</MudTh>
          <MudTh>Chat bot account</MudTh>
          <MudTh>Scope status</MudTh>
          <MudTh>Delete</MudTh>
        </HeaderContent>
        <RowTemplate>
          <MudTd DataLabel="Active">
            <MudRadio Value="@context" Disabled="@(!JoltTwitchAccountManager.HasAllAuthScopes(context))"/>
          </MudTd>
          <MudTd DataLabel="Streamer">
            <TwitchAccount Account="@context.Streamer"/>
          </MudTd>
          <MudTd DataLabel="Chat bot">
            <TwitchAccount Account="@context.ChatBot"/>
          </MudTd>
          <MudTd DataLabel="Scope status">
            @if (JoltTwitchAccountManager.HasAllAuthScopes(context))
            {
              <MudIcon Color="Color.Success" Icon="@Icons.Material.Filled.CheckCircle"/>
            }
            else
            {
              <MudIcon Color="Color.Warning" Icon="@Icons.Material.Filled.Warning"/>
            }
          </MudTd>
          <MudTd DataLabel="Delete">
            <MudIconButton Color="Color.Error" Icon="@Icons.Material.Filled.DeleteForever"
              OnClick="async () => await DeleteAccount(context)"/>
          </MudTd>
        </RowTemplate>
      </MudTable>
    </MudRadioGroup>
  }
  else
  {
    <MudText>There are no connected accounts! Use the button below to add a pair.</MudText>
  }

  <MudButton StartIcon="@Icons.Material.Filled.Add" Href="/twitch/accounts/add/streamer-out">Add</MudButton>
}

@code
{
  JoltTwitchAccountPair Active = JoltTwitchAccountManager.ActiveAccounts ?? default;

  async Task DeleteAccount(JoltTwitchAccountPair accounts)
  {
    await JoltTwitchAccountManager.RemoveAccount(accounts.Streamer.UID);
    StateHasChanged();
  }
}