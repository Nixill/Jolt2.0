@page "/twitch/accounts/add/{type}-in"
@using Microsoft.AspNetCore.Http.Extensions
@using Nixill.Streaming.JoltBot.Twitch
@using System.Web
@using Nixill.Utils.Extensions
@inject NavigationManager NavMan

@Text

@code
{
  string Text = "Loading...";

  [Parameter]
  public string? Type { get; set; }

  public bool IsChatBot => Type == "chatbot";

  public string? Code { get; set; }

  public string? Scope { get; set; }

  public string? HashState { get; set; }

  [SupplyParameterFromQuery]
  public string? State { get; set; } = "";

  [SupplyParameterFromQuery]
  public string? Error { get; set; }

  [SupplyParameterFromQuery(Name = "error_description")]
  public string? ErrorDescription { get; set; }

  protected override async Task OnParametersSetAsync()
  {
    var uri = NavMan.ToAbsoluteUri(NavMan.Uri);
    var fragment = uri.Fragment;
    if (fragment is not null && fragment != "" && fragment != "#")
    {
      var hashProps = fragment[1..].Split('&').Select(t => t.Split('=', 2)
        .Select(f => HttpUtility.UrlDecode(f)).Double())
        .Select(t => new KeyValuePair<string, string>(t.First, t.Second))
        .ToDictionary();
      
      Code = hashProps.GetValueOrDefault("access_token");
      Scope = hashProps.GetValueOrDefault("scope");
      HashState = hashProps.GetValueOrDefault("state");
    }
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (!firstRender) return;

    if (!JoltTwitchAccountManager.IsCorrectChangeState(HashState ?? State!))
    {
      Text = "Incorrect state.";
      StateHasChanged();
      return;
    }
    
    if (Error != null)
    {
      Text = ErrorDescription!;
      StateHasChanged();
      return;
    }

    await JoltTwitchAccountManager.AddAccount(Code!, IsChatBot);
    Text = "Success!"; 
    if (!IsChatBot)
    {
      NavMan.NavigateTo($"/twitch/accounts/add/chatbot-out?state={HashState}");
    }
    else
    {
      NavMan.NavigateTo("/twitch/accounts");
    }
  }
}