@page "/twitch/accounts/add/{type}-in"
@using Microsoft.AspNetCore.Http.Extensions
@using Nixill.Streaming.JoltBot.Twitch
@using System.Web
@using Nixill.Utils.Extensions
@inject NavigationManager NavMan

@Text

@code
{
  string Text = "Loading...";

  [Parameter]
  public string? Type { get; set; }

  public JoltTwitchTokenType TokenType => (Type?.ToLower()) switch {
    "streamer" => JoltTwitchTokenType.Streamer,
    "chatbot" or "chat-bot" /* don't remember which */ => JoltTwitchTokenType.ChatBot,
    _ => TextInvalidTokenType()
  };

  JoltTwitchTokenType TextInvalidTokenType()
  {
    Text = "Invalid token type.";
    throw new Exception("Invalid token type.");
  }

  [SupplyParameterFromQuery]
  public string? Code { get; set; }

  [SupplyParameterFromQuery]
  public string? Scope { get; set; }

  [SupplyParameterFromQuery]
  public string State { get; set; } = "";

  [SupplyParameterFromQuery]
  public string? Error { get; set; }

  [SupplyParameterFromQuery(Name = "error_description")]
  public string? ErrorDescription { get; set; }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (!firstRender) return;

    if (!JoltTwitchAccountManager.IsCorrectChangeState(State))
    {
      Text = "Incorrect state.";
      StateHasChanged();
      return;
    }
    
    if (Error != null)
    {
      Text = ErrorDescription!;
      StateHasChanged();
      return;
    }

    await JoltTwitchAccountManager.AddAccount(Code!, NavMan.Uri[0..NavMan.Uri.IndexOf('?')], TokenType);
    Text = "Success!"; 
    if (TokenType == JoltTwitchTokenType.Streamer)
    {
      NavMan.NavigateTo($"/twitch/accounts/add/chatbot-out?state={State}");
    }
    else
    {
      NavMan.NavigateTo("/twitch/accounts");
    }
  }
}