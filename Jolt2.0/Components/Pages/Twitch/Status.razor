@page "/twitch"
@using Jolt2._0.Components.Span
@using Nixill.Streaming.JoltBot.BotData
@using Nixill.Streaming.JoltBot.NodaTime
@using Nixill.Streaming.JoltBot.Twitch

<PageTitle>Twitch Connection Dashboard</PageTitle>

<MudText>This page lists the status of Jolt's connection to Twitch servers.</MudText>

<MudText Typo="Typo.h2">Account:</MudText>

@if (JoltTwitchAccountManager.ActiveAccounts is JoltTwitchAccountPair accounts)
{
  <MudText>
    Jolt is connected to the streamer account <TwitchAccount Account="@accounts.Streamer" BoldText WithLink />
    and the chat bot account  <TwitchAccount Account="@accounts.ChatBot" BoldText WithLink />.
  </MudText>
}
else
{
  <MudText>
    Jolt is not connected to any accounts. Go to the <MudLink Href="/twitch/accounts">Accounts page</MudLink>
    to fix that.
  </MudText>
}